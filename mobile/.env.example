# Required on physical phones. 127.0.0.1 is THIS device, not the API computer.
# Same Wi-Fi:
#   EXPO_PUBLIC_API_URL=http://192.168.1.20:43121
# Off-network: Fly HTTPS origin after deploy (see DEPLOY.md), e.g.
#   EXPO_PUBLIC_API_URL=https://apex-angi-leads-api.fly.dev
# Expo Go without Fly: run a tunnel to the API, then paste that https URL.
EXPO_PUBLIC_API_URL=
