PORT=43121
HOST=0.0.0.0
JWT_SECRET=change-this-in-production
DATABASE_PATH=./data/apex.sqlite

USER_JARED_EMAIL=jared@apexdrafting.local
USER_JARED_PASSWORD=ApexJared1!
USER_JARED_NAME=Jared

USER_REUBEN_EMAIL=reuben@apexdrafting.local
USER_REUBEN_PASSWORD=ApexReuben1!
USER_REUBEN_NAME=Reuben

# --- Angi for Business / Angi Pro (office.angi.com) ---
# Login email is confirmed. Leave ANGI_PASSWORD blank until it is supplied via
# a secure env (do not commit a password). Cookie poll still works without it.
ANGI_EMAIL=apexdraftingllc@gmail.com
ANGI_PASSWORD=
# Paste the Cookie header from a logged-in office.angi.com tab (Chrome DevTools →
# Network → any office.angi.com request → Cookie). Never commit the real value.
# ANGI_SESSION_COOKIE=
# DevTools XHR that returns lead-summaries JSON (often contains /angiLeads/<id>/
# or /app/h/<id>/). Comma-separated if you have more than one.
# ANGI_LEADS_API_URL=
# Service-provider / account id. Optional when the leads URL already has
# /angiLeads/<id>/ or /app/h/<id>/. Sent as X-ANGI-CallerId.
# ANGI_CALLER_ID=
# Sent as X-ANGI-CallerType on Angi gateway requests. Default: ServiceProvider
# ANGI_CALLER_TYPE=ServiceProvider
# ANGI_POLL_INTERVAL_MS=60000
# ANGI_WEBHOOK_KEY=

# Local Windows / Expo web preview. Fly/Railway set PROXY_EXPO_WEB=0 and
# DATABASE_PATH=/data/apex.sqlite (see DEPLOY.md). Production PORT comes from
# the host (Fly: 8080). HOST should stay 0.0.0.0 so phones and Fly can connect.
EXPO_WEB_PORT=43122
PROXY_EXPO_WEB=1
