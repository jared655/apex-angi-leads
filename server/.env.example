# --- Angi for Business / Angi Pro (office.angi.com) ---
# Do not commit real values. Paste them here OR in the app Settings → Connect Angi Pro.
# Angi has no public OAuth/leads API. Cloudflare sits in front of login (id.angi.com),
# so a session Cookie from a logged-in browser is the working poll path.
#
# ANGI_SESSION_COOKIE=  paste the full Cookie request header from Chrome DevTools
# ANGI_EMAIL=           optional; server-side login is usually blocked by Cloudflare
# ANGI_PASSWORD=
# ANGI_LEADS_API_URL=   optional; DevTools → Network → the XHR that returns leads JSON
# ANGI_POLL_INTERVAL_MS=60000
# ANGI_WEBHOOK_KEY=     shared secret for POST /api/webhooks/angi (header X-API-KEY)

EXPO_WEB_PORT=43122
PROXY_EXPO_WEB=1
