{
  "expo": {
    "name": "APEX Drafting",
    "slug": "apex-drafting",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "apexdrafting",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.apexdrafting.leads",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "APEX Drafting notifies Jared and Reuben when a new Angi lead arrives."
      }
    },
    "android": {
      "package": "com.apexdrafting.leads",
      "adaptiveIcon": {
        "backgroundColor": "#0B1C2C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B1C2C"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C6A15B",
          "defaultChannel": "leads"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "replace-after-eas-init"
      }
    }
  }
}
